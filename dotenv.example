# OSCAL MCP Server Environment Configuration
# To configure the MCP server in your local development environment, 
# copy this file to .env and set appropriate values. See README.md
# for runtime (non-dev) configuration instructions.

# AWS Bedrock Configuration (can be overridden by command line arguments)
# export BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
export OSCAL_KB_ID=

# AWS Configuration
export AWS_PROFILE=your_aws_profile_name
export AWS_REGION=us-east-1

# Logging Configuration
export LOG_LEVEL=INFO

# Server Configuration 
# OSCAL_MCP_SERVER_NAME=OSCAL

# MCP transport (defaults to stdio)
# OSCAL_MCP_TRANSPORT=streamable-http

# Server network configuration (for streamable-http transport / AgentCore deployment)
# OSCAL_MCP_HOST=127.0.0.1
# OSCAL_MCP_STATELESS_HTTP=false

# Component Definition configuration
# OSCAL_ALLOW_REMOTE_URIS=false
# OSCAL_REQUEST_TIMEOUT=30
# OSCAL_MAX_URI_DEPTH=3
# OSCAL_COMPONENT_DEFINITIONS_DIR=component_definitions

# OSCAL Store configuration
# Directory containing your own OSCAL JSON files (catalogs, SSPs, profiles, etc.)
# OSCAL_DOCUMENTS_DIR=
# Path to a persistent SQLite database (reused across restarts when set)
# OSCAL_STORE_DB_PATH=
# Max parsed documents in the in-memory LRU cache
# OSCAL_STORE_CACHE_SIZE=100

# Agent configuration (for oscal_agent.py)
# OSCAL_AGENT_MAX_TOKENS=4096
# OSCAL_AGENT_MAX_RETRY_ATTEMPTS=4
# OSCAL_AGENT_RETRY_INITIAL_DELAY=2
# OSCAL_AGENT_RETRY_MAX_DELAY=60

# Agent session management
# OSCAL_AGENT_SESSION_STORAGE=          # "file" or "s3" (empty = disabled)
# OSCAL_AGENT_SESSION_DIR=.oscal_sessions
# OSCAL_AGENT_SESSION_S3_BUCKET=
# OSCAL_AGENT_SESSION_S3_PREFIX=oscal-agent-sessions/

# Agent conversation management
# OSCAL_AGENT_CONVERSATION_MANAGER=     # "sliding-window", "summarizing", or "null" (empty = SDK default)
